# Environment Variables Example for Adhi's AI Developer Twin
# Copy this file to .env for local server development. DO NOT COMMIT .env TO GIT.

# Server Configuration
PORT=5000

# AI Provider Configuration (Google Gemini / OpenAI / LLM API)
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gemini-1.5-flash

# Allowed Origins (CORS)
ALLOWED_ORIGIN=http://localhost:5173
